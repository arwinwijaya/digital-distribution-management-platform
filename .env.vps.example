# ─────────────────────────────────────────────────────────────────────────────
# VPS Production Environment Configuration
# Copy ke .env di server VPS dan isi values:
#   cp .env.vps.example .env
#
# CATATAN: JANGAN COMMIT file .env yang asli!
# ─────────────────────────────────────────────────────────────────────────────

# ── Server / Network ────────────────────────────────────────────────────────
# IP public VPS (ganti dengan IP VPS Anda)
VPS_IP=119.28.113.18

# Port aplikasi (default 8080, ganti jika perlu)
APP_PORT=8080

# URL publik aplikasi (pakai http:// atau https:// jika sudah setup SSL)
APP_URL=http://119.28.113.18:8080

# Origin yang diizinkan akses API (comma-separated)
CORS_ALLOWED_ORIGINS=http://119.28.113.18:8080

# URL API untuk Next.js (browser-reachable)
NEXT_PUBLIC_API_URL=http://119.28.113.18:8080/api

# ── Application Secrets (GENERATE ULANG DI VPS!) ────────────────────────────
# Generate: php artisan key:generate
# Atau: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=

# Generate: openssl rand -hex 32
# HARUS minimal 32 bytes (64 hex chars) untuk HS256
JWT_SECRET=

JWT_ALGO=HS256
JWT_TTL=1440
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

# ── Database ────────────────────────────────────────────────────────────────
DB_DATABASE=ddp_database
DB_USERNAME=ddp_user
# Generate password kuat: openssl rand -base64 16
DB_PASSWORD=

# ── PWA / Offline ───────────────────────────────────────────────────────────
NEXT_PUBLIC_PWA_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# QUICK SETUP COMMANDS (jalankan di VPS setelah clone):
# ─────────────────────────────────────────────────────────────────────────────
#
# 1. Copy template:
#    cp .env.vps.example .env
#
# 2. Generate secrets:
#    APP_KEY=$(php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;")
#    JWT_SECRET=$(openssl rand -hex 32)
#    DB_PASSWORD=$(openssl rand -base64 16 | tr -dc 'a-zA-Z0-9' | head -c 16)
#
# 3. Update .env:
#    sed -i "s|^APP_KEY=.*|APP_KEY=$APP_KEY|" .env
#    sed -i "s|^JWT_SECRET=.*|JWT_SECRET=$JWT_SECRET|" .env
#    sed -i "s|^DB_PASSWORD=.*|DB_PASSWORD=$DB_PASSWORD|" .env
#
# 4. Deploy:
#    ./scripts/deploy.sh
#
# ─────────────────────────────────────────────────────────────────────────────