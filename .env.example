# Root environment file for docker compose.
#
#   cp .env.example .env
#
# The `api`, `queue-worker` and `scheduler` services load this file via
# `env_file: .env`. Never commit the real `.env`.
#
# Requirements:
#   - APP_KEY: run `php artisan key:generate` or generate with:
#             php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
#   - JWT_SECRET: run `openssl rand -hex 32` (must be >= 32 bytes for HS256)
#   - DB_PASSWORD: use a strong password; must match POSTGRES_PASSWORD in .env
#
# Seeded user credentials (all roles share the same password):
#   Default password : password123
#
#   platform_owner : ahmad.wijaya@ddp.test
#   admin          : ratna.sari@ddp.test, dimas.pratama@ddp.test
#   outlet         : siti.nurhaliza@ddp.test, budi.santoso@ddp.test
#   supplier       : hendra.kurniawan@ddp.test, maya.indah@ddp.test
#   sales          : riko.firmansyah@ddp.test, anisa.putri@ddp.test, ferry.gunawan@ddp.test
#   driver         : joko.widodo@ddp.test, andi.saputra@ddp.test, rudi.hermawan@ddp.test
#   finance        : dewi.lestari@ddp.test, tono.sugiarto@ddp.test

# ── Application ─────────────────────────────────────────────────────────────
APP_PORT=8080
APP_URL=http://localhost:8080

# Generate with: php artisan key:generate   (or: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;")
APP_KEY=

# JWT (tymon/jwt-auth). MUST be at least 32 bytes for HS256, otherwise token
# creation fails with "Key provided is shorter than 256 bits". Generate with:
#   openssl rand -hex 32
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=1440
JWT_REFRESH_TTL=20160
JWT_BLACKLIST_ENABLED=true

# ── Database ────────────────────────────────────────────────────────────────
DB_DATABASE=ddp_database
DB_USERNAME=ddp_user
DB_PASSWORD=change-me-strong-password

# ── Browser origin allowed to call the API (comma-separated) ────────────────
CORS_ALLOWED_ORIGINS=http://localhost:8080

# ── Public API URL baked into the Next.js bundle (must be browser-reachable) ─
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# ── PWA / offline shell (Phase 8) ───────────────────────────────────────────
# Set to `true` to register the app-shell service worker + enable the offline
# page. Leave `false` to fully disable the PWA layer (rollback switch).
NEXT_PUBLIC_PWA_ENABLED=false
