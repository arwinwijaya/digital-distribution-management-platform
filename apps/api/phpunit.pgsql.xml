<?xml version="1.0" encoding="UTF-8"?>
<!--
    CI configuration: runs the suite against PostgreSQL for production parity.

    It is intentionally SEPARATE from phpunit.xml.dist, which pins the safe
    sqlite/:memory: defaults. Here the database is FORCED to the dedicated
    `ddp_test` database so a CI or developer run can never touch a live
    `ddp_database`. Host/port/credentials come from the environment (CI service
    container); only the database NAME is hard-pinned for safety.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <exclude>tests/Feature/Concurrency</exclude>
        </testsuite>
        <testsuite name="Concurrency">
            <directory>tests/Feature/Concurrency</directory>
        </testsuite>
        <testsuite name="Performance">
            <directory>tests/Performance</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="ddp_test" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="JWT_SECRET" value="testing-jwt-secret-min-32-characters!!" force="true"/>
        <env name="JWT_ALGO" value="HS256" force="true"/>

        <!-- PHPUnit's <server> handler always overwrites $_SERVER, which Laravel's
             Env reads before $_ENV/getenv. Pinning connection + database NAME
             here guarantees the suite can never run against a live ddp_database,
             regardless of what the surrounding environment exports. Host, port
             and credentials are intentionally left to the environment (the CI
             service container). -->
        <server name="APP_ENV" value="testing"/>
        <server name="DB_CONNECTION" value="pgsql"/>
        <server name="DB_DATABASE" value="ddp_test"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="JWT_SECRET" value="testing-jwt-secret-min-32-characters!!"/>
        <server name="JWT_ALGO" value="HS256"/>
    </php>
</phpunit>
